# CHAI Global Health Research Hub - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP server settings for sending email digests
# For Gmail: smtp.gmail.com, port 587
# For Outlook: smtp-mail.outlook.com, port 587

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Your email address (sender address for digests)
EMAIL_ADDRESS=your-email@gmail.com

# Email password or app password
# IMPORTANT: For Gmail with 2-Factor Authentication enabled:
#   1. Go to Google Account > Security > 2-Step Verification
#   2. Scroll down to "App passwords"
#   3. Generate a new app password for "Mail"
#   4. Use that 16-character password here (without spaces)
EMAIL_PASSWORD=your-app-password-here

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================
# Secret key for session security
# Generate a random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-string-at-least-32-characters

# Debug mode - set to 'true' ONLY for local development
# WARNING: Never enable debug mode in production!
FLASK_DEBUG=false

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Base URL for your deployed application
# Used for links in emails (unsubscribe, preferences, etc.)
# Examples:
#   - Local development: http://localhost:5000
#   - Production: https://your-app-name.herokuapp.com
#   - Custom domain: https://health-tracker.yourdomain.com
BASE_URL=http://localhost:5000

# Port to run the server on (hosting platforms set this automatically)
# PORT=5000

# Database URL (hosting platforms often set this automatically)
# For local SQLite, leave unset to use default
# For PostgreSQL: postgresql://user:password@host:port/database
# DATABASE_URL=

# =============================================================================
# PUBMED API CONFIGURATION
# =============================================================================
# Your email address (required by NCBI for API access)
# NCBI uses this to contact you if there are problems with your requests
PUBMED_EMAIL=your-email@gmail.com
